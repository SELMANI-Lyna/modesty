generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                String       @id @default(cuid())
  name              String
  description       String?
  price             Float
  salePrice         Float?
  category          Category     @default(JUPE)
  images            String[]
  isBestseller      Boolean      @default(false)
  isOnSale          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  lowStockThreshold Int          @default(2)
  isOnPromo         Boolean      @default(false)
  colors            Color[]
  feedbacks         Feedback[]
  variants          Variant[]
  collections       Collection[] @relation("CollectionToProduct")
}

model Color {
  id        String  @id @default(cuid())
  name      String
  hex       String
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Variant {
  id                String      @id @default(cuid())
  size              String
  colorName         String
  colorHex          String
  image             String?
  price             Float?
  reducedPrice      Float?
  quantity          Int         @default(0)
  sku               String?
  isActive          Boolean     @default(true)
  productId         String
  lowStockAlertSent Boolean     @default(false)
  orderItems        OrderItem[]
  product           Product     @relation(fields: [productId], references: [id])

  @@unique([productId, sku])
}

model Order {
  id           String      @id @default(cuid())
  clientName   String
  phone        String
  wilaya       String
  commune      String
  deliveryType String
  status       String      @default("pending")
  totalPrice   Float
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String
  quantity     Int
  priceAtOrder Float
  order        Order   @relation(fields: [orderId], references: [id])
  variant      Variant @relation(fields: [variantId], references: [id])
}

model Feedback {
  id         String   @id @default(cuid())
  clientName String
  message    String
  rating     Int?
  photos     String[]
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  productId  String?
  storyLink  String?
  product    Product? @relation(fields: [productId], references: [id])
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String
  createdAt DateTime @default(now())
}

model Collection {
  id        String    @id @default(cuid())
  name      String
  image     String?
  status    String    @default("not_in_store")
  createdAt DateTime  @default(now())
  products  Product[] @relation("CollectionToProduct")
}

model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

enum Category {
  JUPE
  ENSEMBLE
  ROBE
  HIJAB
  PANTALON
  VESTE
}
